# OpenTofu / Terraform
#
# *.tfstate covers the per-account state-backend bootstrap files under
# live/*/*/bootstrap/*/terraform.tfstate too. Those are deliberately local and deliberately NOT
# committed: they are state, and they name real infrastructure. Losing one costs an import-based
# recovery, not an outage -- see docs/adr/0011.
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terragrunt
.terragrunt-cache/
.terragrunt-stack/

# The bootstrap units run OpenTofu against the shared module, so init drops a copy of the module's
# lockfile beside them. The authoritative one is modules/state-backend/.terraform.lock.hcl.
live/*/*/bootstrap/*/.terraform.lock.hcl

# Variables that may hold real values (examples are tracked explicitly)
*.tfvars
*.tfvars.json
!*.example.tfvars
!example.tfvars

# Secrets / local tooling
.env
.env.*
*.pem
*.key
kubeconfig*
.gitleaks.local.toml

# OS / editor
.DS_Store
*.swp
*~
.idea/
.vscode/

# Per-account config is filled in from the .example templates; the real files are local.
live/*/account.hcl
!live/*/account.hcl.example
