{
  "uid": "red-services",
  "title": "RED — Services",
  "tags": ["red", "observability"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "namespace", "type": "query", "datasource": "${datasource}", "label": "namespace", "includeAll": true, "multi": false, "query": "label_values(service:request_rate:rate5m, service_namespace)", "refresh": 2 },
      { "name": "service", "type": "query", "datasource": "${datasource}", "label": "service", "includeAll": true, "multi": true, "query": "label_values(service:request_rate:rate5m{service_namespace=\"$namespace\"}, service_name)", "refresh": 2 }
    ]
  },
  "panels": [
    { "id": 1, "title": "Rate — requests/sec", "type": "timeseries", "datasource": "${datasource}", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }, "targets": [ { "expr": "sum by (service_name) (service:request_rate:rate5m{service_namespace=\"$namespace\", service_name=~\"$service\"})", "legendFormat": "{{service_name}}" } ] },
    { "id": 2, "title": "Errors — 5xx ratio", "type": "timeseries", "datasource": "${datasource}", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }, "fieldConfig": { "defaults": { "unit": "percentunit" } }, "targets": [ { "expr": "service:error_ratio:rate5m{service_namespace=\"$namespace\", service_name=~\"$service\"}", "legendFormat": "{{service_name}}" } ] },
    { "id": 3, "title": "Duration — p99 seconds", "type": "timeseries", "datasource": "${datasource}", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [ { "expr": "service:latency_p99:5m{service_namespace=\"$namespace\", service_name=~\"$service\"}", "legendFormat": "{{service_name}}" } ] },
    { "id": 4, "title": "Duration — p99 with exemplars (raw histogram)", "type": "timeseries", "datasource": "${datasource}", "description": "Same p99 as the panel above, but computed from the raw histogram instead of the service:latency_p99:5m recording rule. Exemplars are attached to the underlying bucket samples and do not survive rule evaluation, so this is the panel that can carry them: each diamond is one sampled request — click it to pivot to that request's trace in the trace backend the export seam selected.", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }, "fieldConfig": { "defaults": { "unit": "s" } }, "targets": [ { "expr": "histogram_quantile(0.99, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"$namespace\", service_name=~\"$service\"}[5m])))", "legendFormat": "{{service_name}}", "exemplar": true } ] }
  ]
}
